# 테이블 생성
CREATE TABLE `user_tbl` (
  `user_id` bigint NOT NULL AUTO_INCREMENT,
  `email` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL,
  `password` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `nickname` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `role` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `status` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  `deleted_at` timestamp NULL DEFAULT NULL,
  `last_login_at` timestamp NULL DEFAULT NULL,
  `provider` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `provider_id` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  PRIMARY KEY (`user_id`),
  UNIQUE KEY `email` (`email`),
  UNIQUE KEY `nickname` (`nickname`)
) ENGINE=InnoDB AUTO_INCREMENT=1 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;



CREATE TABLE `refresh_tbl` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `username` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL,
  `refresh_token` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL,
  `token_expiration` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=1 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;



CREATE TABLE `group_theme_tbl` (
  `group_theme_id` bigint NOT NULL AUTO_INCREMENT,
  `theme` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL,
  PRIMARY KEY (`group_theme_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

INSERT INTO group_theme_tbl (theme) VALUES ('요리'), ('음악');



CREATE TABLE `group_tbl` (
  `group_id` bigint NOT NULL AUTO_INCREMENT,
  `group_name` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL,
  `description` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
  `theme_id` bigint DEFAULT NULL,
  `leader_id` bigint NOT NULL,
  `member_limit` int unsigned DEFAULT NULL,
  `current_member_count` int unsigned DEFAULT '1',
  `is_private` tinyint(1) DEFAULT '0',
  `password` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `background_image` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `is_deleted` tinyint(1) DEFAULT '0',
  `created_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` timestamp NULL DEFAULT NULL,
  `deleted_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`group_id`),
  KEY `leader_id` (`leader_id`),
  KEY `theme_id` (`theme_id`),
  CONSTRAINT `group_tbl_ibfk_1` FOREIGN KEY (`leader_id`) REFERENCES `user_tbl` (`user_id`),
  CONSTRAINT `group_tbl_ibfk_2` FOREIGN KEY (`theme_id`) REFERENCES `group_theme_tbl` (`group_theme_id`)
) ENGINE=InnoDB AUTO_INCREMENT=132 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;



CREATE TABLE `group_member_tbl` (
  `group_member_id` bigint NOT NULL AUTO_INCREMENT,
  `group_id` bigint NOT NULL,
  `user_id` bigint NOT NULL,
  `joined_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP,
  `is_kicked` tinyint(1) DEFAULT '0',
  `is_saved_rocket` tinyint(1) DEFAULT '0',
  PRIMARY KEY (`group_member_id`),
  UNIQUE KEY `unique_group_user` (`group_id`,`user_id`),
  KEY `fk_group_member_user` (`user_id`),
  CONSTRAINT `fk_group_member_group` FOREIGN KEY (`group_id`) REFERENCES `group_tbl` (`group_id`),
  CONSTRAINT `fk_group_member_user` FOREIGN KEY (`user_id`) REFERENCES `user_tbl` (`user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;



CREATE TABLE `group_rocket_tbl` (
  `group_rocket_id` bigint NOT NULL AUTO_INCREMENT,
  `group_id` bigint NOT NULL,
  `receiver_id` bigint DEFAULT NULL,
  `rocket_name` varchar(255) DEFAULT NULL,
  `design` varchar(255) DEFAULT NULL,
  `is_lock` tinyint(1) DEFAULT '1',
  `lock_expired_at` timestamp NULL DEFAULT NULL,
  `sent_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`group_rocket_id`),
  KEY `fk_group` (`group_id`),
  KEY `fk_group_rocket_receiver` (`receiver_id`),
  CONSTRAINT `fk_group` FOREIGN KEY (`group_id`) REFERENCES `group_tbl` (`group_id`) ON DELETE CASCADE,
  CONSTRAINT `fk_group_rocket_receiver` FOREIGN KEY (`receiver_id`) REFERENCES `user_tbl` (`user_id`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;



CREATE TABLE `group_rocket_content_tbl` (
  `grc_id` bigint NOT NULL AUTO_INCREMENT,
  `group_rocket_id` bigint DEFAULT NULL,
  `group_id` bigint NOT NULL,
  `user_id` bigint NOT NULL,
  `content` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
  `is_ready` tinyint(1) DEFAULT '0',
  `is_deleted` tinyint(1) DEFAULT '0',
  `created_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` timestamp NULL DEFAULT NULL,
  `deleted_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`grc_id`),
  KEY `fk_grc_user` (`user_id`),
  KEY `fk_grc_group_rocket` (`group_rocket_id`),
  KEY `fk_grc_group` (`group_id`),
  CONSTRAINT `fk_grc_group` FOREIGN KEY (`group_id`) REFERENCES `group_tbl` (`group_id`) ON DELETE CASCADE,
  CONSTRAINT `fk_grc_group_rocket` FOREIGN KEY (`group_rocket_id`) REFERENCES `group_rocket_tbl` (`group_rocket_id`) ON DELETE SET NULL,
  CONSTRAINT `fk_grc_user` FOREIGN KEY (`user_id`) REFERENCES `user_tbl` (`user_id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=7 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;


CREATE TABLE `rocket_tbl` (
  `rocket_id` bigint NOT NULL AUTO_INCREMENT,
  `sender_id` bigint DEFAULT NULL,
  `receiver_id` bigint DEFAULT NULL,
  `rocket_name` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `design` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `is_lock` tinyint(1) DEFAULT '1',
  `lock_expired_at` timestamp NULL DEFAULT NULL,
  `receiver_type` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `content` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
  `is_temp` tinyint(1) DEFAULT NULL,
  `temp_created_at` timestamp NULL DEFAULT NULL,
  `sent_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`rocket_id`),
  KEY `fk_rocket_sender_user` (`sender_id`),
  KEY `fk_rocket_receiver_user` (`receiver_id`),
  CONSTRAINT `fk_rocket_receiver_user` FOREIGN KEY (`receiver_id`) REFERENCES `user_tbl` (`user_id`),
  CONSTRAINT `fk_rocket_sender_user` FOREIGN KEY (`sender_id`) REFERENCES `user_tbl` (`user_id`)
) ENGINE=InnoDB AUTO_INCREMENT=296 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;



CREATE TABLE `rocket_file_tbl` (
  `file_id` bigint NOT NULL AUTO_INCREMENT,
  `rocket_id` bigint DEFAULT NULL,
  `group_rocket_id` bigint DEFAULT NULL,
  `original_name` varchar(255) DEFAULT NULL,
  `unique_name` varchar(255) DEFAULT NULL,
  `saved_path` varchar(500) DEFAULT NULL,
  `file_type` varchar(100) DEFAULT NULL,
  `file_size` bigint DEFAULT NULL,
  `file_order` int DEFAULT '0',
  `uploaded_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP,
  `grc_id` bigint DEFAULT NULL,
  PRIMARY KEY (`file_id`),
  UNIQUE KEY `uk_unique_name` (`unique_name`),
  KEY `rocket_id` (`rocket_id`),
  KEY `group_rocket_id` (`group_rocket_id`),
  KEY `fk_rocket_file_grc` (`grc_id`),
  CONSTRAINT `fk_rocket_file_grc` FOREIGN KEY (`grc_id`) REFERENCES `group_rocket_content_tbl` (`grc_id`) ON DELETE CASCADE,
  CONSTRAINT `rocket_file_fk_group_rocket` FOREIGN KEY (`group_rocket_id`) REFERENCES `group_rocket_tbl` (`group_rocket_id`) ON DELETE CASCADE,
  CONSTRAINT `rocket_file_tbl_ibfk_1` FOREIGN KEY (`rocket_id`) REFERENCES `rocket_tbl` (`rocket_id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=125 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;



CREATE TABLE `sent_chest_tbl` (
  `sent_chest_id` bigint NOT NULL AUTO_INCREMENT,
  `rocket_id` bigint NOT NULL,
  `is_deleted` tinyint(1) DEFAULT '0',
  `deleted_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`sent_chest_id`),
  KEY `rocket_id` (`rocket_id`),
  CONSTRAINT `sent_chest_tbl_ibfk_1` FOREIGN KEY (`rocket_id`) REFERENCES `rocket_tbl` (`rocket_id`)
) ENGINE=InnoDB AUTO_INCREMENT=1 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;



CREATE TABLE `received_chest_tbl` (
  `received_chest_id` bigint NOT NULL AUTO_INCREMENT,
  `rocket_id` bigint NOT NULL,
  `is_public` tinyint(1) DEFAULT '0',
  `public_at` timestamp NULL DEFAULT NULL,
  `display_location` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `is_deleted` tinyint(1) DEFAULT '0',
  `deleted_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`received_chest_id`),
  KEY `rocket_id` (`rocket_id`),
  CONSTRAINT `received_chest_tbl_ibfk_1` FOREIGN KEY (`rocket_id`) REFERENCES `rocket_tbl` (`rocket_id`)
) ENGINE=InnoDB AUTO_INCREMENT=1 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;